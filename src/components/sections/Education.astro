---
import Section from "../Section.astro";

import { education } from "@cv";
---

<Section title="Educación">
  <ul>
    {
      education.map(({ institution, url, startDate, endDate, area }) => {
        const startYear = startDate.slice(0, 4);
        const endYear =
          endDate != null ? endDate.slice(0, 4) : "Actual";
        const years = `${startYear} - ${endYear}`;

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="institution-link"
                      title={`Visitar el sitio web de ${institution}`}
                    >
                      {institution}
                      <span class="external-link" aria-hidden="true">↗</span>
                    </a>
                  </h3>
                </div>

                <time>{years}</time>
              </header>

              <footer>
                <p>{area}</p>
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }

  .institution-link {
    align-items: baseline;
    color: #111;
    display: inline-flex;
    gap: 4px;
    text-decoration: underline;
    text-decoration-color: #bbb;
    text-underline-offset: 3px;
  }

  .institution-link:hover {
    color: #2563eb;
    text-decoration-color: currentColor;
  }

  .external-link {
    color: #777;
    font-size: 0.65rem;
    text-decoration: none;
  }

  @media print {
    .institution-link {
      color: #111;
      text-decoration: none;
    }

    .external-link {
      display: none;
    }
  }
</style>
