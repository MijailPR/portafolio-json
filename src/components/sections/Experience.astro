---
import Section from "../Section.astro";

import { work } from "@cv";
---

<Section title="Experiencia laboral">
  <ul class="experience-list" style="margin-top: 15px;">
    {
      work.map(
        ({ name, startDate, endDate, position, summary, highlights, url }) => {
          const startYear = startDate.slice(0, 4);
          const endYear =
            endDate != null ? endDate.slice(0, 4) : "Actual";

          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>
                      <a
                        class="company-link"
                        href={url}
                        title={`Visitar el sitio web de ${name}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {name}
                        <span class="external-link" aria-hidden="true">↗</span>
                      </a>
                    </h3>
                    <h4>{position}</h4>
                  </div>

                  <div>
                    <time datetime={startDate} data-title={startDate}>
                      {startYear}
                    </time>
                    {" - "}
                    <time datetime={endDate} data-title={endDate}>
                      {endYear}
                    </time>
                  </div>
                </header>

                <footer>
                  <p>{summary}</p>
                  {
                    highlights.length > 0 && (
                      <ul class="highlights">
                        {highlights.map((highlight) => <li>{highlight}</li>)}
                      </ul>
                    )
                  }
                </footer>
              </article>
            </li>
          );
        },
      )
    }
  </ul>
</Section>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
    padding-left: 18px;
  }

  .highlights li {
    color: #555;
    font-size: 0.8rem;
    line-height: 1.35;
    list-style: disc;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article a {
    color: #111;
  }

  .company-link {
    align-items: baseline;
    display: inline-flex;
    gap: 4px;
    text-decoration: underline;
    text-decoration-color: #bbb;
    text-underline-offset: 3px;
  }

  .company-link:hover {
    color: #2563eb;
    text-decoration-color: currentColor;
  }

  .external-link {
    color: #777;
    font-size: 0.65rem;
    text-decoration: none;
  }

  article h4 {
    color: #222;
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    cursor: default;
  }

  [data-title]:hover:after {
    opacity: 1;
    transition: all 0.1s ease-in-out 0.5s;
    visibility: visible;
  }

  [data-title]:after {
    content: attr(data-title);
    background-color: #333;
    color: #fff;
    font-size: 0.75rem;
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      monospace;
    position: absolute;
    padding: 0.2rem 0.5rem;
    bottom: -1.4rem;
    left: 50%;
    white-space: nowrap;
    box-shadow: 1px 1px 1px #222222;
    opacity: 0;
    border: 1px solid #111111;
    z-index: 99999;
    visibility: hidden;
    border-radius: 6px;
  }

  [data-title] {
    position: relative;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }

  @media print {
    .company-link {
      color: #111;
      text-decoration: none;
    }

    .external-link {
      display: none;
    }

    .highlights {
      gap: 3px;
    }

    .highlights li {
      font-size: 0.72rem;
    }
  }
</style>
